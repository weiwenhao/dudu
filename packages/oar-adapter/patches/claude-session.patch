+        const finish = (body) => sent === null ? body : { request: sent, response: kernel.respond(id, body) };
+        if (blocked) return finish(blocked);
+        const { promise, resolve } = Promise.withResolvers();
+        const timer = setTimeout(() => resolve({ subtype: "error", error: `${subtype} timed out` }), 30_000);
+        pending.set(id, resolve);
+        try {
+            child.write(`${JSON.stringify({ type: "control_request", request_id: id, request: { subtype, ...fields } })}\n`);
+            const answer = await promise;
+            return finish(answer.subtype === "success" ? { kind: "accepted", native: answer.response }

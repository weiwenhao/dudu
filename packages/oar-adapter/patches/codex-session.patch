+import { rpcControl } from "./rpc-control.js";
+
+/** Dudu extension: observe and stop the app-server's own background terminals, without launching another shell. */
+export function codexBackgroundTasks(client, kernel, threadId) {
+    let current = new Map();
+    const ended = new Map();
+    const stopping = new Map();
+    let refreshing;
+    return {
+        owns: (taskId) => current.has(taskId),
+        note(method, params) {
+            const item = params.item;
+            if (method === "item/completed" && item?.type === "commandExecution" && item.exitCode !== null && item.exitCode !== undefined
+                && [...current.values()].some(row => row.itemId === item.id)) {
+                ended.set(item.id, { status: item.status === "completed" && item.exitCode === 0 ? "completed" : "failed" });
+            }
+        },
+        refresh() {
+            return refreshing ??= (async () => {
+                let cursor;
+                const rows = [];
+                do {
+                    const reply = await client.request("thread/backgroundTerminals/list", { threadId, ...(cursor ? { cursor } : {}) });
+                    rows.push(...reply.data ?? []);
+                    cursor = reply.nextCursor;
+                } while (cursor);
+                const next = new Map(rows.map(row => [row.processId, row]));
+                const events = [];
+                for (const [id, row] of next) if (!current.has(id)) events.push({
+                    kind: "task_started", taskId: id, taskType: "shell", nativeType: "commandExecution",
+                    description: row.command, toolCallId: row.itemId, background: true,
+                });
+                for (const [id, row] of current) if (!next.has(id)) {
+                    const stop = stopping.get(id);
+                    // Termination can publish item/completed before its RPC reply. Wait for both facts.
+                    if (stop?.pending) { next.set(id, row); continue; }
+                    events.push({
+                        kind: "task_ended", taskId: id, status: stop?.accepted ? "stopped" : ended.get(row.itemId)?.status ?? "stopped",
+                    });
+                    stopping.delete(id);
+                    ended.delete(row.itemId);
+                }
+                current = next;
+                if (events.length) kernel.frame({ type: "thread/backgroundTerminals/list", native: { data: rows }, events });
+            })().finally(() => { refreshing = undefined; });
+        },
+        stopTask(taskId) {
+            const stop = { pending: true, accepted: false };
+            stopping.set(taskId, stop);
+            return rpcControl(kernel, client, {
+                body: { kind: "native", type: "thread/backgroundTerminals/terminate", native: { threadId, processId: taskId } },
+                gate: () => null,
+                method: "thread/backgroundTerminals/terminate",
+                params: () => ({ threadId, processId: taskId }),
+                onReply: reply => {
+                    stop.pending = false;
+                    stop.accepted = true;
+                    return { kind: "accepted", native: reply };
+                },
+                onError: reason => {
+                    stopping.delete(taskId);
+                    return { kind: "rejected", code: "runtime_refused", reason };
+                },
+            });
+        },
+    };
+}

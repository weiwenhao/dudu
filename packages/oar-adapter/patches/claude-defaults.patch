+/** Token-free native configuration in the launch directory. The private response never leaves OAR. */
+export async function claudeConfiguration(installation, options = {}) {
+    if (installation.via !== "executable") throw new Error("Claude configuration requires an executable installation");
+    const outcome = await readOutcome(installation.command, listingCwd(options), options.timeoutMs ?? 15_000, options.env, "get_settings", options.model);
+    if (outcome.kind !== "ok") throw new Error("Claude could not report its startup configuration");
+    const payload = asRecord(outcome.payload);
+    const applied = asRecord(payload?.applied);
+    const effective = asRecord(payload?.effective);
+    const permissions = asRecord(effective?.permissions);
+    const permissionMode = text(permissions?.defaultMode);
+    const effortLevels = new Set(["low", "medium", "high", "xhigh", "max"]);
+    const modelEfforts = Object.fromEntries(Object.entries(asRecord(effective?.modelSettings) ?? {})
+        .flatMap(([id, settings]) => effortLevels.has(asRecord(settings)?.effortLevel) ? [[id, settings.effortLevel]] : []));
+    return {
+        ...(text(effective?.model) ? { model: text(effective.model) } : {}),
+        ...(text(applied?.model) ? { resolvedModel: text(applied.model) } : {}),
+        ...(text(applied?.effort) ? { effort: text(applied.effort) } : {}),
+        ...(effortLevels.has(effective?.effortLevel) ? { defaultEffort: effective.effortLevel } : {}),
+        ...(Object.keys(modelEfforts).length ? { modelEfforts } : {}),
+        ...(["auto", "default", "manual", "acceptEdits", "plan", "dontAsk", "bypassPermissions"].includes(permissionMode) ? { permissionMode } : {}),
+    };
+}

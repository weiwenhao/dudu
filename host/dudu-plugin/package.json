{
  "name": "dudu",
  "version": "0.4.0",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "description": "Dudu 手机连接：配置连接地址、生成配对码和管理设备",
  "icon": "./icon.png",
  "license": "MIT",
  "files": ["index.mjs", "client.js", "icon.png", "cordis.patch.yml", "dist/"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0"
  }
}

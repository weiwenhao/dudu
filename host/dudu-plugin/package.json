{
  "name": "dsh-dudu",
  "version": "0.1.1",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./computer-use": "./dist/computer-use/provider.mjs",
    "./client": "./dist/client.js",
    "./widget": {
      "types": "./widget.d.ts",
      "import": "./widget.mjs"
    },
    "./widget-ui": {
      "types": "./widget-ui.d.ts",
      "import": "./widget-ui.mjs"
    },
    "./widget-testing": {
      "types": "./widget-testing.d.ts",
      "import": "./widget-testing.mjs"
    },
    "./widget.css": "./widget.css",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "description": "An efficient multi-agent collaboration assistant built on DSH",
  "icon": "./icon.png",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/weiwenhao/dudu.git" },
  "homepage": "https://github.com/weiwenhao/dudu#readme",
  "bugs": { "url": "https://github.com/weiwenhao/dudu/issues" },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "multi-agent"],
  "files": ["index.mjs", "client.js", "widget.mjs", "widget.d.ts", "widget-ui.mjs", "widget-ui.d.ts", "widget-testing.mjs", "widget-testing.d.ts", "widget.css", "icon.png", "cordis.patch.yml", "locale/", "WIDGETS.md", "dist/"],
  "engines": { "dsh": ">=0.2.1-alpha.3" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0"
  }
}

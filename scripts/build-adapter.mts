import { copyFile, mkdir, writeFile } from 'node:fs/promises';
import './build-icons.mjs';
const { createMobileAdapterScript } = await import('../src/mobile-adapter.ts');

await mkdir(new URL('../dist/', import.meta.url), { recursive: true });
await writeFile(new URL('../dist/mobile-adapter.js', import.meta.url),
  createMobileAdapterScript({ nativeToolbar: false }));
await mkdir(new URL('../src/generated/', import.meta.url), { recursive: true });
// Hermes does not preserve function source text in release bytecode.
await writeFile(new URL('../src/generated/mobile-adapter.ts', import.meta.url),
  '// Generated by npm run build:adapter. Edit src/mobile-adapter.ts instead.\n'
  + `export const MOBILE_ADAPTER_SCRIPT = ${JSON.stringify(createMobileAdapterScript())};\n`);
await mkdir(new URL('../host/plugin/dist/', import.meta.url), { recursive: true });
await copyFile(new URL('../dist/mobile-adapter.js', import.meta.url), new URL('../host/plugin/dist/mobile-adapter.js', import.meta.url));
await copyFile(new URL('../host/relay.mjs', import.meta.url), new URL('../host/plugin/dist/relay.mjs', import.meta.url));
await copyFile(new URL('../host/pairing.mjs', import.meta.url), new URL('../host/plugin/dist/pairing.mjs', import.meta.url));
console.log('Built mobile adapter.');

{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄对话图片，或扫描电脑上的 Dudu 配对二维码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos for conversations, or scan the Dudu pairing QR code on your computer."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你电脑上的 DSH，继续对话和管理任务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to DSH on your computer to continue conversations and manage tasks."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话，将语音转换为对话文字。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to speak and convert speech into conversation text."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将会话图片保存到照片图库。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save conversation images to your photo library."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择照片作为对话附件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photos to attach to conversations."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将语音识别为文字，发送到当前会话。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert speech to text to send to the current session."
          }
        }
      }
    }
  },
  "version": "1.0"
}

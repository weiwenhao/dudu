{
  "name": "harness-mobile",
  "version": "0.1.0",
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "expo": "~58.0.14",
    "expo-camera": "~58.0.10",
    "expo-file-system": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "expo-speech-recognition": "^58.0.0",
    "expo-status-bar": "~58.0.3",
    "lucide-react-native": "^1.59.0",
    "qrcode-terminal": "^0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@botiverse/oar": "0.75.0",
    "@tailwindcss/cli": "4.3.3",
    "@tanstack/react-virtual": "3.14.10",
    "@types/react": "~19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "esbuild": "0.25.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "lucide-react": "1.65.0",
    "postcss": "8.5.32",
    "postcss-prefix-selector": "2.2.1",
    "radix-ui": "1.8.1",
    "react-day-picker": "10.0.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "npm run build:adapter",
    "prestart": "npm run build:adapter",
    "start": "expo start",
    "preandroid": "npm run build:adapter",
    "android": "expo run:android",
    "ios": "node scripts/native-ios.mjs --install",
    "native:project": "xcodegen generate --spec native/project.yml --project native",
    "native:review-pages": "node scripts/export-review-pages.mjs",
    "native:build": "node scripts/native-ios.mjs",
    "native:install": "node scripts/native-ios.mjs --install",
    "native:test": "node scripts/native-ios.mjs --test",
    "legacy:ios": "expo run:ios",
    "preweb": "npm run build:adapter",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:adapter": "node --experimental-strip-types scripts/build-adapter.mts",
    "share": "npm run build:adapter && node scripts/share.mjs",
    "desktop:link": "node scripts/desktop-link.mjs",
    "desktop:update": "node scripts/update-desktop.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "client:build": "node scripts/build-client.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preexport": "npm run build:adapter",
    "export": "expo export --platform all",
    "lint": "expo lint",
    "logs:pull": "node scripts/pull-device-logs.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "private": true
}

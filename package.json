  "scripts": {
    "postinstall": "npm run oar:prepare && npm run computer-use:prepare && npm run build:adapter",
    "prestart": "npm run build:adapter",
    "start": "expo start",
    "preandroid": "npm run build:adapter",
    "android": "expo run:android",
    "ios": "node scripts/native-ios.mjs --install",
    "native:project": "xcodegen generate --spec native/ios/project.yml --project native/ios",
    "native:review-pages": "node scripts/export-review-pages.mjs",
    "native:build": "node scripts/native-ios.mjs",
    "native:install": "node scripts/native-ios.mjs --install",
    "native:test": "node scripts/native-ios.mjs --test",
    "android:build": "node scripts/native-android.mjs",
    "android:install": "node scripts/native-android.mjs --install",
    "android:test": "node scripts/native-android.mjs --unit",
    "android:e2e": "node scripts/native-android.mjs --e2e",
    "legacy:ios": "expo run:ios",
    "preweb": "npm run build:adapter",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "oar:prepare": "node packages/oar-adapter/build.mjs",
    "computer-use:prepare": "node packages/dsh-computer-use/build.mjs",
    "build:adapter": "node --experimental-strip-types scripts/build-adapter.mts",
    "share": "npm run build:adapter && node scripts/share.mjs",
    "desktop:link": "node scripts/desktop-link.mjs",
    "desktop:update": "node scripts/update-desktop.mjs",
    "desktop:install": "node scripts/update-desktop.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "client:build": "node scripts/build-client.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preexport": "npm run build:adapter",
    "export": "expo export --platform all",
    "lint": "expo lint",
    "logs:pull": "node scripts/pull-device-logs.mjs",
    "logs:reads": "node scripts/read-log.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}

  "main": "index.ts",
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@expo/metro-runtime": "~58.0.14",
    "expo": "~58.0.14",
    "expo-camera": "~58.0.10",
    "expo-file-system": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "expo-speech-recognition": "^58.0.0",
    "expo-status-bar": "~58.0.3",
    "lucide-react-native": "^1.59.0",

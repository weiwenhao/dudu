    "croner": "11.0.0",
    "esbuild": "0.25.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "gridstack": "14.0.0",
    "lucide-react": "1.65.0",
    "mdast-util-from-markdown": "2.1.0",
    "pixi.js": "8.18.1",
    "playwright-core": "1.64.1",
    "postcss": "8.5.32",
    "postcss-prefix-selector": "2.2.1",
    "radix-ui": "1.8.1",
    "react-day-picker": "10.0.2",
    "react-markdown": "10.1.0",
    "remark-cjk-friendly": "2.3.3",
    "remark-gfm": "4.0.1",

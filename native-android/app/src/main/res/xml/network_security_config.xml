<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Pairing explicitly chooses an HTTP or HTTPS computer. TLS uses system trust. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
